#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
rm -rf dist
mkdir dist
for arch in amd64 arm64; do
  CGO_ENABLED=0 GOOS=linux GOARCH="$arch" go build -trimpath -buildvcs=false \
    -ldflags='-s -w' -o "dist/holon-mcp-runtime-linux-$arch" ./cmd/holon-mcp-runtime
done
cd dist
sha256sum holon-mcp-runtime-linux-* > SHA256SUMS
